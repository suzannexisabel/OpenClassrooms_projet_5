@startuml
hide methods
hide stereotypes
skinparam classAttributeIconSize 0

package "app schema" {

  class model_registry {
    +id : SERIAL <<PK>>
    --
    name : TEXT
    version : TEXT
    artifact_path : TEXT
    created_at : TIMESTAMPTZ
    --
    {static} UNIQUE(name, version)
  }

  class prediction_request {
    +id : BIGSERIAL <<PK>>
    --
    request_id : UUID <<UNIQUE>>
    created_at : TIMESTAMPTZ
    endpoint : TEXT
    input_json : JSONB
    --
    idx_prediction_request_created_at(created_at DESC)
  }

  class prediction_result {
    +id : BIGSERIAL <<PK>>
    --
    request_id : UUID <<FK>>
    model_id : INTEGER <<FK>>
    threshold : DOUBLE PRECISION
    proba_positive : DOUBLE PRECISION
    prediction : INTEGER
    latency_ms : INTEGER
    created_at : TIMESTAMPTZ
    --
    idx_prediction_result_request(request_id)
  }

  class employee_dataset {
    +id : BIGSERIAL <<PK>>
    --
    age : INTEGER
    genre : TEXT
    poste : TEXT
    nombre_experiences_precedentes : INTEGER
    niveau_hierarchique_poste : INTEGER
    heure_supplementaires : INTEGER
    a_quitte_l_entreprise : INTEGER
    nombre_participation_pee : INTEGER
    niveau_education : INTEGER
    domaine_etude : TEXT
    ratio_anciennete_manager : DOUBLE PRECISION
    frequence_deplacement_code : INTEGER
    score_satisfaction_global : DOUBLE PRECISION
    delta_evaluation : INTEGER
    "Célibataire" : INTEGER
    annees_dans_l_entreprise_bins : INTEGER
    distance_domicile_travail_bins : INTEGER
    created_at : TIMESTAMPTZ
  }

  prediction_request "1" <-- "0..*" prediction_result : request_id
  model_registry     "1" <-- "0..*" prediction_result : model_id
}

@enduml